# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit it.

# --- Postgres (used by the `db` container and to build DATABASE_URL in Compose) ---
POSTGRES_USER=ledgerforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ledgerforge

# --- App ---
# Used when running the app directly on your machine (outside Docker).
# Docker Compose overrides this with host `db`.
DATABASE_URL=postgresql+psycopg://ledgerforge:change-me@localhost:5432/ledgerforge
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
